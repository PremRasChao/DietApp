# Supabase — Project Settings → Data API → Project URL (bare domain, no /rest/v1/)
EXPO_PUBLIC_SUPABASE_URL=
# Supabase — Project Settings → API Keys → Publishable key (or legacy anon public key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Cloud Console → Clients → Web application client ID (ends in .apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google Cloud Console → Clients → iOS application client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
