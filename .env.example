# Copy to .env and fill in. .env is gitignored — never commit real keys.
# NOTE: EXPO_PUBLIC_* values are bundled into the client app and are therefore
# visible to anyone who inspects the build. For anything sensitive in
# production, proxy the call through a backend instead of shipping the key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_USDA_KEY=
EXPO_PUBLIC_SPOONACULAR_KEY=

# Mistral AI API key — https://console.mistral.ai/api-keys
EXPO_PUBLIC_MISTRAL_API_KEY=
